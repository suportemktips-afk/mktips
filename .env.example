# Copie para .env.local (não commitar)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sessões HMAC (obrigatório em produção — use string longa aleatória)
SESSION_SECRET=

# Admin login (Vercel)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Obrigatório — sem isso o login admin é bloqueado
ADMIN_2FA_CODE=

# Pagamentos
VELANA_SECRET_KEY=
VELANA_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=

# Auto-import / cron (obrigatório para rotas de job)
AUTO_IMPORT_SECRET=
CRON_SECRET=

# WhatsApp — manter false até anunciar nas comunidades
WHATSAPP_SEND_ENABLED=false
WACLI_BASE_URL=http://localhost:3333

# App URL (produção)
NEXT_PUBLIC_APP_URL=https://saa-s-sports-tips-three.vercel.app
